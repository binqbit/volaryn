#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"
case "${1:---help}" in
app)
  if (($# != 1)); then
    echo "Usage: tools/test app" >&2
    exit 2
  fi
  exec "$repo_root/tools/test-app"
  ;;
full)
  if (($# != 1)); then
    echo "Usage: tools/test full" >&2
    exit 2
  fi
  exec "$repo_root/tools/test-full"
  ;;
--help | -h)
  echo "Usage: tools/test {fast|docker|app|full} [scenario-filter]"
  echo "fast: run contract checks locally with the pinned development tools."
  echo "docker: check formatting and run contract checks with containerized tools."
  echo "app: check the backend and frontend locally without a validator."
  echo "full: build/check everything and run an isolated browser settlement on Compose."
  echo "Only full starts a validator and application services."
  exit 0
  ;;
fast | docker)
  mode="$1"
  shift
  ;;
*)
  echo "Unknown suite. Use: tools/test {fast|docker|app|full} [scenario-filter]" >&2
  exit 2
  ;;
esac
if (($# > 1)); then
  echo "Expected at most one scenario filter" >&2
  exit 2
fi
if [[ "$mode" == fast ]]; then
  exec "$repo_root/tools/test-host" "$@"
fi
mkdir -p artifacts/tests
run_dir="$(mktemp -d "$repo_root/artifacts/tests/contract.XXXXXX")"
echo "Test artifacts: $run_dir"
docker build --target contract-tests --iidfile "$run_dir/image-id" . 2>&1 | tee "$run_dir/build.log"
# The source is copied into the image. No host wallet, data volume, or network is mounted.
docker run --rm --network none "$(cat "$run_dir/image-id")" "${1:-}" 2>&1 | tee "$run_dir/contract.log"
