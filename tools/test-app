#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"
export PATH="$repo_root/tools/rustup:$PATH"
for tool in rustup node npm python3 postgres initdb pg_ctl psql; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Missing $tool; see docs/development.md" >&2
    exit 1
  fi
done
cargo clippy --locked -p volaryn-backend --all-targets --features localnet -- -D warnings
python3 tools/postgres/with-test-db.py cargo test --locked -p volaryn-backend --features localnet
cargo run --locked --quiet -p volaryn-backend --bin export-openapi >target/openapi.json
cmp packages/api/openapi.json target/openapi.json
npm ci
npm run check:generated
npm run typecheck
npm run lint
npm test
npm run build
npm run build:live
npm run check:live
