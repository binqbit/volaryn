{
  "name": "volaryn",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "packages/protocol"
  ],
  "scripts": {
    "generate:protocol": "node tools/generate-protocol.mjs",
    "generate:api": "openapi-typescript packages/api/openapi.json -o frontend/src/lib/api/schema.ts",
    "typecheck": "tsc -p frontend/tsconfig.json && tsc -p tsconfig.tools.json",
    "build": "vite build --config frontend/vite.config.ts --mode localnet",
    "build:live": "vite build --config frontend/vite.config.ts --mode production",
    "test": "vitest run --config frontend/vite.config.ts",
    "test:e2e": "playwright test",
    "localnet:bootstrap": "tsx tools/localnet/bootstrap.ts",
    "dev:localnet": "python3 tools/postgres/with-local-db.py node_modules/.bin/tsx tools/localnet/dev.ts",
    "test:localnet": "python3 tools/postgres/with-test-db.py node_modules/.bin/tsx tools/localnet/test-native.ts",
    "check:generated": "node tools/check-generated.mjs",
    "check:live": "node tools/check-live.mjs",
    "lint": "eslint frontend/src tools/localnet tests/browser tests/tooling packages/protocol/src playwright.config.ts",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,css,html}\" \"packages/protocol/src/**/*.ts\" \"tools/**/*.{ts,mjs}\" \"tests/{browser,tooling}/**/*.ts\" playwright.config.ts eslint.config.js",
    "format:write": "prettier --write \"frontend/**/*.{ts,tsx,css,html}\" \"packages/protocol/src/**/*.ts\" \"tools/**/*.{ts,mjs}\" \"tests/{browser,tooling}/**/*.ts\" playwright.config.ts eslint.config.js"
  },
  "dependencies": {
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana-program/token-2022": "0.18.0",
    "@solana/kit": "8.3.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "codama": "1.11.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  }
}
