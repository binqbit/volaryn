{
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "lf",
  "markdown": {
    "textWrap": "maintain"
  },
  "ruff": {
    "indentWidth": 4,
    "lineLength": 100
  },
  "excludes": [
    "**/target/**",
    "**/node_modules/**",
    "artifacts/**",
    "debug-tools/**",
    "deployment/**",
    "packages/protocol/idl/**",
    "Cargo.lock",
    "frontend/dist/**",
    "frontend/dist-live/**",
    "packages/api/openapi.json",
    "package-lock.json",
    "packages/protocol/src/generated/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.24.0.wasm",
    "https://plugins.dprint.dev/markdown-0.24.0.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/dockerfile-0.6.0.wasm",
    "https://plugins.dprint.dev/ruff-0.8.8.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
