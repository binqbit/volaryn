# Optional. Docker Compose works without an .env file.
# Copy to .env for local Compose, or add these values to deployment/release.env
# for a live deployment. Native processes read exported environment variables.

# Reconcile known agreements and operation receipts. Accepted: 1–10 seconds.
VOLARYN_INDEX_POLL_INTERVAL_SECS=1

# Minimum interval between discovery passes. Accepted: 1–300 seconds.
VOLARYN_INDEX_DISCOVERY_INTERVAL_SECS=2
