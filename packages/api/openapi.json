{
  "openapi": "3.1.0",
  "info": {
    "title": "Volaryn API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/agreements": {
      "get": {
        "operationId": "agreements",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "Last address from the previous page (exclusive).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, from 1 to 200. Defaults to 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "holder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "writer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "quantity_raw",
            "in": "query",
            "description": "Exact underlying quantity in base units; offers are never resized.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_payout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_premium",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eligible_holder",
            "in": "query",
            "description": "Include unrestricted offers and offers reserved for this holder.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {
              "X-Next-Cursor": {
                "schema": {
                  "type": "string"
                },
                "description": "Exclusive address cursor for the next page; absent on the last page"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgreementView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/agreements/{address}": {
      "get": {
        "operationId": "agreement",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgreementView"
                }
              }
            }
          }
        }
      }
    },
    "/api/assets": {
      "get": {
        "operationId": "assets",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssetView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/assets/official": {
      "get": {
        "operationId": "official_assets",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfficialCatalog"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "operationId": "config",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deployment"
                }
              }
            }
          }
        }
      }
    },
    "/api/offers": {
      "get": {
        "operationId": "offers",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "Last address from the previous page (exclusive).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, from 1 to 200. Defaults to 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "holder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "writer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "quantity_raw",
            "in": "query",
            "description": "Exact underlying quantity in base units; offers are never resized.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_payout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_premium",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eligible_holder",
            "in": "query",
            "description": "Include unrestricted offers and offers reserved for this holder.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {
              "X-Next-Cursor": {
                "schema": {
                  "type": "string"
                },
                "description": "Exclusive address cursor for the next page; absent on the last page"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgreementView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/wallet": {
      "get": {
        "operationId": "wallet",
        "parameters": [
          {
            "name": "owner",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgreementView": {
        "type": "object",
        "required": [
          "address",
          "version",
          "writer",
          "underlyingMint",
          "underlyingProgram",
          "underlyingDecimals",
          "usdcMint",
          "quantityRaw",
          "payout",
          "premium",
          "acceptBefore",
          "expiresAt",
          "status",
          "policyVersion",
          "reserve",
          "reserveAmount",
          "settlement",
          "netReceived",
          "finalizedSlot",
          "observedAt"
        ],
        "properties": {
          "acceptBefore": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "designatedHolder": {
            "type": [
              "string",
              "null"
            ]
          },
          "expiresAt": {
            "type": "string"
          },
          "finalizedSlot": {
            "type": "string"
          },
          "holder": {
            "type": [
              "string",
              "null"
            ]
          },
          "netReceived": {
            "type": "string"
          },
          "observedAt": {
            "type": "integer",
            "format": "int64"
          },
          "payout": {
            "type": "string"
          },
          "policyVersion": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "premium": {
            "type": "string"
          },
          "quantityRaw": {
            "type": "string"
          },
          "reserve": {
            "type": "string"
          },
          "reserveAmount": {
            "type": "string"
          },
          "settlement": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "underlyingDecimals": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "underlyingMint": {
            "type": "string"
          },
          "underlyingProgram": {
            "type": "string"
          },
          "usdcMint": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "writer": {
            "type": "string"
          }
        }
      },
      "AssetView": {
        "type": "object",
        "required": [
          "mint",
          "symbol",
          "name",
          "decimals",
          "referenceMint",
          "source"
        ],
        "properties": {
          "decimals": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "mint": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "referenceMint": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Deployment": {
        "type": "object",
        "required": [
          "schemaVersion",
          "fixtureVersion",
          "mode",
          "genesisHash",
          "programId",
          "programSha256",
          "programLength",
          "authority",
          "holder",
          "writer",
          "usdcMint",
          "assets",
          "writerUsdc",
          "holderUsdc"
        ],
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetView"
            }
          },
          "authority": {
            "type": "string"
          },
          "fixtureVersion": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "genesisHash": {
            "type": "string"
          },
          "holder": {
            "type": "string"
          },
          "holderUsdc": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "programId": {
            "type": "string"
          },
          "programLength": {
            "type": "integer",
            "minimum": 0
          },
          "programSha256": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "usdcMint": {
            "type": "string"
          },
          "writer": {
            "type": "string"
          },
          "writerUsdc": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Eligibility": {
        "type": "string",
        "enum": [
          "compatible",
          "unsupported",
          "unreviewed",
          "expired",
          "stale",
          "unavailable"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FeeSchedule": {
        "type": "object",
        "required": [
          "epoch",
          "basisPoints",
          "maximumRaw"
        ],
        "properties": {
          "basisPoints": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "epoch": {
            "type": "string"
          },
          "maximumRaw": {
            "type": "string"
          }
        }
      },
      "MarketContext": {
        "type": "object",
        "required": [
          "unitsVerified"
        ],
        "properties": {
          "impliedValuation": {
            "type": [
              "string",
              "null"
            ]
          },
          "markPrice": {
            "type": [
              "string",
              "null"
            ]
          },
          "markValuation": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The public response supplies no price timestamp or verified price/display-unit contract."
          },
          "supply": {
            "type": [
              "string",
              "null"
            ]
          },
          "tokenPrice": {
            "type": [
              "string",
              "null"
            ]
          },
          "unitsVerified": {
            "type": "boolean"
          }
        }
      },
      "MintEvidence": {
        "type": "object",
        "required": [
          "tokenProgram",
          "decimals",
          "supplyRaw",
          "extensions",
          "authorities",
          "transparentTransferSupported",
          "restrictions"
        ],
        "properties": {
          "authorities": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "currentFee": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/FeeSchedule"
              }
            ]
          },
          "decimals": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "displayMultiplier": {
            "type": [
              "string",
              "null"
            ]
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "multiplierEffectiveAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "nextDisplayMultiplier": {
            "type": [
              "string",
              "null"
            ]
          },
          "nextFee": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/FeeSchedule"
              }
            ]
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supplyRaw": {
            "type": "string"
          },
          "tokenProgram": {
            "type": "string"
          },
          "transparentTransferSupported": {
            "type": "boolean"
          }
        }
      },
      "OfficialAsset": {
        "type": "object",
        "required": [
          "mint",
          "name",
          "symbol",
          "eligibility",
          "reason"
        ],
        "properties": {
          "chain": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MintEvidence"
              }
            ]
          },
          "eligibility": {
            "$ref": "#/components/schemas/Eligibility"
          },
          "market": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MarketContext"
              }
            ]
          },
          "mint": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "policy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReviewedAsset"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        }
      },
      "OfficialCatalog": {
        "type": "object",
        "required": [
          "network",
          "genesisHash",
          "source",
          "marketSource",
          "chainSource",
          "assets"
        ],
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfficialAsset"
            }
          },
          "chainSource": {
            "$ref": "#/components/schemas/SourceObservation"
          },
          "finalizedSlot": {
            "type": [
              "string",
              "null"
            ]
          },
          "genesisHash": {
            "type": "string"
          },
          "marketSource": {
            "$ref": "#/components/schemas/SourceObservation"
          },
          "network": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "ReviewedAsset": {
        "type": "object",
        "required": [
          "mint",
          "name",
          "symbol",
          "decimals",
          "source",
          "reviewedAt",
          "reviewedUntil",
          "maxExpiry",
          "expiryBufferSeconds"
        ],
        "properties": {
          "conversionDeadline": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "decimals": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "expiryBufferSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "maxExpiry": {
            "type": "integer",
            "format": "int64"
          },
          "mint": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reviewedAt": {
            "type": "integer",
            "format": "int64"
          },
          "reviewedUntil": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SourceObservation": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "receivedAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/SourceStatus"
          }
        }
      },
      "SourceStatus": {
        "type": "string",
        "enum": [
          "fresh",
          "stale",
          "unavailable"
        ]
      },
      "WalletTokenAccount": {
        "type": "object",
        "required": [
          "address",
          "mint",
          "tokenProgram",
          "amountRaw",
          "frozen",
          "decimals",
          "finalizedSlot"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "amountRaw": {
            "type": "string"
          },
          "decimals": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "finalizedSlot": {
            "type": "string"
          },
          "frozen": {
            "type": "boolean"
          },
          "mint": {
            "type": "string"
          },
          "tokenProgram": {
            "type": "string"
          }
        }
      },
      "WalletView": {
        "type": "object",
        "required": [
          "owner",
          "accounts"
        ],
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletTokenAccount"
            }
          },
          "owner": {
            "type": "string"
          }
        }
      }
    }
  }
}
