{
  "openapi": "3.1.0",
  "info": {
    "title": "Volaryn API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/agreements": {
      "get": {
        "operationId": "agreements",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "Last address from the previous page (exclusive).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, from 1 to 200. Defaults to 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "holder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "writer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "quantity_raw",
            "in": "query",
            "description": "Exact underlying quantity in base units; offers are never resized.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_payout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_premium",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eligible_holder",
            "in": "query",
            "description": "Include unrestricted offers and offers reserved for this holder.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {
              "X-Next-Cursor": {
                "schema": {
                  "type": "string"
                },
                "description": "Exclusive address cursor for the next page; absent on the last page"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgreementView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/agreements/{address}": {
      "get": {
        "operationId": "agreement",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgreementView"
                }
              }
            }
          }
        }
      }
    },
    "/api/assets": {
      "get": {
        "operationId": "assets",
